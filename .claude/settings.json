{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|WebFetch|WebSearch)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/identity-guard.mjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|PowerShell|WebFetch|WebSearch)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/identity-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
